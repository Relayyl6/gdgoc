<section class="developers-community-stats">
  <h2 class="section-title developers-heading-4" id="backed-by-a-global-community" data-text="Backed by a global community" tabindex="-1">Backed by a global community</h2>
  <div class="developers-grid">
    <div class="stats-wrapper">
      
      <div class="stat-item">
        <span class="stat-label developers-text-label blue-square-icon-before">COMMUNITY GROUPS</span>
        <span class="stat-value">2000+</span>
