}

.developers-community-map .devsite-gdg-map-results-container .devsite-gdg-map-result:first-of-type {
  padding-block-start: 24px;
}

.devsite-gdg-map-result-header .devsite-gdg-map-result-icon {
  display: none;
}

.developers-community-map .devsite-gdg-map-cluster-marker--devfest-blue-cluster-icon {
