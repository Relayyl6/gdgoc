  font-family: var(--gfd-font-family-code);
}

.devsite-gdg-map-result-actions {
  margin-block-start: 16px;
}

.developers-community-map .devsite-gdg-map-result-actions :nth-child(2) .button {
  --devsite-button-border: none;
  --devsite-button-background: transparent;
  --devsite-button-border-radius: 0;
  --devsite-button-box-shadow: none;
  --devsite-button-color: var(--blue-500);
  --devsite-button-max-width: none;
  --devsite-button-margin-x-end: 12px;
  --devsite-button-margin: 0;
  --devsite-button-height: auto;
  --devsite-button-padding: 0;
  --devsite-button-text-transform: uppercase;
  --devsite-button-width: auto;
  --devsite-button-text-decoration-hover: none;
  --devsite-button-background-hover: transparent;
  --devsite-button-border-hover: none;
  --devsite-button-color-hover: var(--gfd-palette-blue-300);
  text-decoration: underline;
  position: relative;
  display: flex;
  gap: 4px;
  align-items: center;
  font: 450 14px / 18.3px var(--gfd-font-family-code);
  padding-right: 22px;
  position: relative;
}

.developers-community-map .devsite-gdg-map-result-actions :nth-child(2) .button:hover {
  font-weight: 450;
}

.developers-community-map .devsite-gdg-map-result-actions :nth-child(2) .button:after {
  content: "arrow_outward";
