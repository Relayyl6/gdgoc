      <div class="community-card">
        <div class="card-logo">
          <img src="/static/assets/img/icons/google-bracket.svg" alt>
        </div>
        <p class="card-title developers-text-body">Google Developer Groups</p>
        <p class="card-description developers-text-body">Connect, learn, and grow alongside Google's technologies and experts.</p>
        <a href="https://app.advocu.com/gdg/join" class="developers-btn-blue">Lead a GDG</a>
      </div>
      
      <div class="community-card">
        <div class="card-logo">
          <img src="/static/assets/img/icons/google-bracket.svg" alt>
        </div>
        <p class="card-title developers-text-body">Google Developer Groups on Campus</p>
        <p class="card-description developers-text-body">Gain hands-on experience, develop essential skills, and build a strong foundation for a tech career.</p>
        <a href="https://app.advocu.com/gdg/join" class="developers-btn-blue">Lead a GDG on Campus</a>
