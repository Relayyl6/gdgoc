      /* Styles inlined from /site-assets/styles/community-redesign.css */
/* Community Hero Module */
.developers-community-hero {
  position: relative;
  padding-block: 160px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  margin-block-end: 88px;
  overflow-y: clip;
}

@media (min-width: 768px) {
  .developers-community-hero {
    block-size: 100svh;
    max-block-size: 800px;
    padding-block: 120px 80px;
    margin-block-end: 120px;
  }
}

.developers-community-hero .hero-bg {
  background-color: var(--gfd-palette-black);
  position: absolute;
  inset: 0 -24px;
  z-index: -1;
  overflow: hidden;
}

@media (min-width: 1600px) {
  .developers-community-hero {
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    overflow: hidden;
  }

  .developers-community-hero .hero-bg {
    inset: 0
  }
}

.developers-community-hero .hero-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 48px;
  width: 100%;
}

.developers-community-hero .hero-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.developers-community-hero .eyebrow {
  font-family: var(--gfd-font-family-code);
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.22px;
  text-transform: uppercase;
  margin-block-end: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.developers-community-hero .developers-btn-blue {
  margin-block-start: 48px;
}

.developers-community-hero .hero-asset {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.developers-community-hero .hero-asset img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.developers-community-hero .hero-asset img.mobile-only {
  display: block;
}

.developers-community-hero .hero-asset img.desktop-only {
  display: none;
}

@media (min-width: 1024px) {
  .developers-community-hero .hero-asset img.mobile-only {
    display: none;
  }

  .developers-community-hero .hero-asset img.desktop-only {
    display: block;
  }
}

.developers-community-hero .hero-asset video {
  width: 100%;
  height: auto;
  display: block;
  transform: scale(1.7) translateY(-21%);
}

@media (min-width: 1440px) {
  .developers-community-hero .hero-asset video {
    transform: none;
  }
}

.developers-community-hero .developers-heading-2 {
  max-width: 690px;
  color: var(--gfd-grey-0);
  margin-block-end: 0;
}

/* Community Map Module */
.developers-community-map {}

.developers-community-map .developers-grid {
  row-gap: 0;
}

.developers-community-map .section-title {
  margin-block-end: 0;
}

.section-header {
  grid-column: 1 / -1;
  margin-block-end: 36px;
}

@media screen and (min-width: 1024px) {
  .section-header {
    grid-column: 1 / span 6;
  }
}

.map-wrapper {
  grid-column: 1 / -1;
}

.section-body {
  color: var(--gfd-grey-800);
  margin: 0;
}

.map-widget {
  border: 2px solid var(--devsite-primary-text-color);
  border-radius: 16px;
}

.map-widget-filter-toggle {
  color: #202124;
}

.map-widget-filter-toggle:hover,
.map-widget-filter-toggle:focus {
  background: #202124;
  color: white;
}

.map-widget-chips label {
  background: white;
  border: 2px solid #000;
  color: #000;
}

.map-widget-chips input[type='checkbox']:checked + label {
  background: #e8f0fe;
  border: 2px solid #1967d2;
  color: #1967d2;
}

.developers-community-map devsite-gdg-map {
  --devsite-gdg-map-border: none;
  --devsite-gdg-map-result-border: none;
  --devsite-gdg-map-result-hover-border: none;
  --devsite-gdg-map-result-padding: 15px;
  --devsite-gdg-map-result-hover-padding: 15px;
}

.developers-community-map .devsite-gdg-map-filter-container {
  padding-block-end: 12px;
}

.developers-community-map .devsite-gdg-map-filter-container ul {
  gap: 12px;
}

.developers-community-map .devsite-gdg-map-filter-container ul li label {
  background: #eff2f7;
  border-radius: 4px;
  font: var(--gfd-font-weight-450) 13px / 21px var(--gfd-font-family-code);
  text-transform: uppercase;
  padding: 8px 18px;
  color: var(--gfd-grey-1200);
  border: none;
}

.devsite-gdg-map-filter-container ul li label:not(.devsite-gdg-map-filter-chip--selected):hover {
  background: var(--gfd-grey-100);
}

.devsite-gdg-map-filter-container ul li label.devsite-gdg-map-filter-chip--selected {
  background: var(--gfd-theme-on-surface);
  color: var(--gfd-grey-0);
}

.devsite-gdg-map-filter-container ul li label.devsite-gdg-map-filter-chip--selected:hover {
  background: var(--gfd-grey-800);
}

.developers-community-map .devsite-gdg-map-filter-chip-clear {
  font: var(--gfd-font-weight-450) 13px / 21px var(--gfd-font-family-code);
  color: var(--gfd-grey-1200);
  text-transform: uppercase;
}

.developers-community-map .devsite-gdg-map-filter-chip-clear:hover,
.developers-community-map .devsite-gdg-map-filter-chip-clear:focus,
.developers-community-map .devsite-gdg-map-filter-chip-clear:active {
  text-decoration: underline;
  background: transparent;
}

.developers-community-map .devsite-gdg-map-container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.developers-community-map .devsite-gdg-map-map-container {
  border-radius: 8px;
  grid-column: 1 / -1;
}

.developers-community-map .devsite-gdg-map-container--has-results .devsite-gdg-map-map-container {
  grid-column: 1 / -1;
}

.developers-community-map .devsite-gdg-map-container--has-results .devsite-gdg-map-results-container {
  grid-column: 1 / -1;
}

.developers-community-map .devsite-gdg-map-search-container {
  gap: 12px;
  inset-inline-start: 12px;
  inset-block-start: 12px;
}

@media screen and (min-width: 1024px) {
  .developers-community-map .devsite-gdg-map-container {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 14px;
  }

  .developers-community-map .devsite-gdg-map-container--has-results .devsite-gdg-map-map-container {
    grid-column: span 9;
  }

  .developers-community-map .devsite-gdg-map-container--has-results .devsite-gdg-map-results-container {
    grid-column: 10 / span 3;
  }

  .developers-community-map .devsite-gdg-map-search-container {
    gap: 18px;
  }
}

.developers-community-map .devsite-gdg-map-search-input {
    --devsite-input-padding: 9px 42px 9px 12px;
    --devsite-input-border: none;
    --devsite-input-border-radius: 4px;
    --devsite-input-width: 210px;
    --devsite-input-border-bottom-focus: var(--devsite-input-border);
    --devsite-input-padding-bottom-focus: 8px;
    font: 450 13px / 13px var(--gfd-font-family-code);
    --devsite-input-background: var(--gfd-grey-20);
    text-transform: uppercase;
}

.devsite-gdg-map-filter-group-container {
    background: transparent;
    border: none;
    height: 33px;
    gap: 4px;
    justify-content: flex-start;
  }

.developers-community-map .devsite-gdg-map-filter-group-container label {
  border-radius: 4px;
  color: rgba(18, 19, 23, 0.6);
  background: rgba(239, 242, 247, 0.63);
