/* Community Discord Module */
.developer-community-discord .discord-image-container {
  grid-column: span 4;
}

.developer-community-discord .discord-image {
  width: 100%;
  height: auto;
  border-radius: 8px;
  display: block;
}

.developer-community-discord .discord-content {
  grid-column: span 4;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.developer-community-discord .discord-content .developers-heading-4 {
  margin-bottom: 24px;
}

.developer-community-discord .discord-content .developers-text-body {
  margin-bottom: 48px;
  color: var(--gfd-grey-800);
  max-inline-size: 492px;
}

@media (min-width: 1024px) {
  .developer-community-discord .developers-grid {
    align-items: center;
  }

  .developer-community-discord .discord-image-container {
    grid-column: span 5;
  }
  
  .developer-community-discord .discord-content {
    grid-column: 7 / span 5;    
  }
}

/* Community Stats Module */
.developers-community-stats .section-title {
  margin-bottom: 40px;
}


.developers-community-stats .stats-wrapper {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  align-content: start;
}

.developers-community-stats .cards-wrapper {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}

.developers-community-stats .stat-item {
  display: flex;
  flex-direction: column;
  border-top: 1px solid rgba(98, 98, 98, 0.3);
  padding-block-start: 24px;
}

@media screen and (min-width: 1024px) {
  .developers-community-stats .stats-wrapper {
    grid-column: span 4;
  }

  .developers-community-stats .cards-wrapper {
    grid-column: span 8;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
}

.developers-community-stats .stat-label {
  color: #000;
  margin-block-end: 4px;;
}

.developers-community-stats .stat-value {
  font-family: var(--gfd-font-family-code);
  font-size: 38px;
  line-height: 72px;
  letter-spacing: -1.44px;
  color: #000;
  font-weight: 400;
  margin: 0;
}

.developers-community-stats .community-card {
  background-color: var(--gfd-grey-20);
  padding: 24px 24px 90px;
  border-radius: 4px;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: background-color 0.2s ease;
  grid-column: 1 / -1;
}

@media screen and (min-width: 768px) {
  .developers-community-stats .community-card {
    grid-column: span 1;
  }
}

.card-logo {
  margin-block-end: 24px;
}

.developers-community-stats .community-card .card-title {
  margin-block-end: 4px;
}

.developers-community-stats .community-card .card-description {
  color: var(--gfd-grey-800);
  flex-grow: 1;
}

.community-card .developers-btn-blue {
  position: absolute;
  bottom: 8px;
  right: 8px;
}

/* Community Program Module */
.developers-community-program .section-title {
  margin-bottom: 36px;
}

.developers-community-program .program-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  block-size: 440px;
  border-radius: 8px;
  background-size: cover;
  background-position: center;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  padding: 20px;
  box-sizing: border-box;
  grid-column: 1 / -1;
}

@media screen and (min-width: 768px) {
  .developers-community-program .program-card {
    grid-column: span 2;
  }
}

@media screen and (min-width: 1024px) {
  .developers-community-program .program-card {
    block-size: 560px;

    &.span-8 {
      grid-column: span 8;
    }

    &.span-4 {
      grid-column: span 4;
    }
  }
}

.developers-community-program .program-card h3 {
  color: var(--gfd-grey-0);
  margin-bottom: 24px;
}

.developers-community-program .program-card .developers-text-body {
  color: var(--gfd-theme-inverse-on-surface-variant);
  max-width: 345px;
}

.developers-community-program .program-card-cta {
  position: absolute;
  bottom: 8px;
  right: 8px;
  height: 48px;
  min-width: 48px;
  background-color: var(--gfd-palette-blue-500); /* adjust to design system blue */
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 17px;
  box-sizing: border-box;
  color: var(--gfd-grey-0);
}

.developers-community-program .program-card-cta .material-symbols-outlined {
  font-size: 14.5px;
  flex-shrink: 0;
}

.developers-community-program .program-card-cta .cta-text-wrapper {
  display: grid;
  grid-template-columns: 0fr;
  transition: grid-template-columns 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.developers-community-program .program-card-cta .cta-text-grid-item {
  overflow: hidden;
  min-width: 0;
}

.developers-community-program .program-card-cta .cta-text {
  padding-right: 12px;
  white-space: nowrap;
  font-size: 14px;
  font-weight: 500;
  opacity: 0;
  transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);;
}

/* Hover state for expanding CTA */
.developers-community-program .program-card:hover,
.developers-community-program .program-card:focus {
  text-decoration: none;
}

.developers-community-program .program-card:hover .program-card-cta .cta-text-wrapper,
.developers-community-program .program-card:focus .program-card-cta .cta-text-wrapper {
  grid-template-columns: 1fr;
}

.developers-community-program .program-card:hover .program-card-cta .cta-text,
.developers-community-program .program-card:focus .program-card-cta .cta-text {
  opacity: 1;
  transition-delay: 0.1s;
}

@media screen and (max-width: 1023px) {
  .developers-community-program .program-card-cta .cta-text-wrapper {
    grid-template-columns: 1fr;
  }

  .developers-community-program .program-card-cta .cta-text {
    opacity: 1;
  }
}

/* Community Socials Module */
.developers-community-socials h2 {
  margin-bottom: 36px;
}

.developers-community-socials .social-card {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: var(--gfd-grey-20);
  border-radius: 4px;
  text-decoration: none;
  block-size: 126px;
  grid-column: span 2;
  position: relative;
  overflow: hidden;
}

.developers-community-socials .social-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--background-hover, #E2E8F0);
  opacity: 0;
  transition: opacity 0.2s ease;
  z-index: 1;
}

.developers-community-socials .social-card:hover::before,
.developers-community-socials .social-card:focus::before {
  opacity: 1;
}

.developers-community-socials .social-card img {
  position: relative;
  z-index: 2;
}

.developers-community-socials .social-card:hover img,
.developers-community-socials .social-card:focus img {
  filter: brightness(0) invert(1);
}

/* On desktop, span 2 columns in the 12-column grid */
@media (min-width: 1024px) {
  .developers-community-socials .social-card {
    grid-column: span 2;
  }
}

.developers-community-hero .hero-buttons {
  display: flex;
  flex-flow: row wrap;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-block-start: 48px;
}

.developers-community-hero .hero-buttons .developers-btn-blue {
  margin-block-start: 0;
}

.developers-btn-white {
  background-color: #fff;
  color: var(--gfd-palette-blue-500);
  padding: 12px 14px;
  border-radius: 4px;
  text-decoration: none;
  font-weight: var(--gfd-font-weight-450);
  font-size: var(--gfd-font-size-sm);
  line-height: var(--gfd-line-height-sm);
  white-space: nowrap;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease-out, color 0.2s ease-out;
}

.developers-btn-white:hover,
.developers-btn-white:focus {
  background-color: var(--gfd-palette-grey-100, #f1f3f4);
  color: var(--gfd-palette-blue-300);
  text-decoration: none;
}




