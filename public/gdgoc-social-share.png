}

.developers-community-map .devsite-gdg-map-filter-group-container label.devsite-gdg-map-filter-group--selected {
  height: auto;
  color: var(--gfd-grey-1200);
  background: rgba(239, 242, 247, 1);
}

.developers-community-map .devsite-gdg-map-filter-group-container .devsite-gdg-map-filter-group-dot {
  height: 9px;
  width: 9px;
  background: rgba(18, 19, 23, 0.6);
}

.developers-community-map .devsite-gdg-map-filter-group-container .devsite-gdg-map-filter-group--selected .devsite-gdg-map-filter-group-dot {
  background: var(--gfd-palette-blue-500);
}

.developers-community-map .devsite-gdg-map-results-container {
  border-top: 1px solid rgba(33, 34, 38, 0.12);
}

.developers-community-map .devsite-gdg-map-results-container .devsite-gdg-map-result{
